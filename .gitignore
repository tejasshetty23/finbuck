# dependencies
node_modules/
/.pnp
.pnp.js

# next.js
/.next/
# previous build kept by deploy.sh so a failed rebuild can be rolled back
/.next.prev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# local env files. The trailing-* forms matter: `.env*.local` alone does not
# cover `.env.local.bak`, and this file carries the Stake API key on a public
# repo.
.env*.local
.env
.env.*
*.env
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules

# Source art and scratch files dropped in the project root. The optimised
# copies that the site actually loads live in public/ — these originals are
# large, and this repo is public, so they stay on disk but out of git.
/*.png
/*.jpg
/*.pdf

# The real Stake standings. Full usernames and wagers (masked only when
# rendered) on a public repo — upload it to the server, never commit it.
# data/leaderboard.sample.csv is the committed placeholder.
/data/leaderboard.csv

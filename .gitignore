# dependencies
node_modules/
/.pnp
.pnp.js

# next.js
/.next/
# previous build kept by deploy.sh so a failed rebuild can be rolled back
/.next.prev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# local env files. The trailing-* forms matter: `.env*.local` alone does not
# cover `.env.local.bak`, and this file carries the never-pick list on a public
# repo.
.env*.local
.env
.env.*
*.env
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules
